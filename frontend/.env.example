# Copia este archivo como .env.local y reemplaza los valores:
#   cp .env.example .env.local   (Mac/Linux)
#   copy .env.example .env.local (Windows)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Panel Superadmin (sprint 020) -------------------------------------------
# Solo en server. En producción se cargan en Vercel → Settings → Environment
# Variables (NO se commitean). Sin estas variables el login superadmin
# responde 500 ("Panel superadmin no configurado").
SUPERADMIN_EMAIL=admin@clarocomunica.com
SUPERADMIN_PASSWORD=cambia-esta-clave
SUPERADMIN_SECRET=string-random-de-32-caracteres-minimo

# Key de service role de Supabase (bypassa RLS) para que el superadmin lea/
# escriba todas las empresas. Mismo nombre que usa el bot. NO es NEXT_PUBLIC.
SERVICE_ROLE_KEY=your-supabase-service-role-key
